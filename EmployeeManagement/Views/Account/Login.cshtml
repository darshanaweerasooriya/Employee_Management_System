@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LoginLayout.cshtml"; // Make sure this file exists
}

<h3 class="text-center mb-4">Login</h3>

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">@ViewBag.Message</div>
}

@using (Html.BeginForm("Login", "Home", FormMethod.Post, new { id = "loginForm" }))
{
    <div class="form-group mb-3">
        <label>Email</label>
        @Html.TextBox("Email", null, new { @class = "form-control", @placeholder = "Enter email" })
    </div>
    <div class="form-group mb-3">
        <label>Password</label>
        @Html.Password("Password", null, new { @class = "form-control", @placeholder = "Enter password" })
    </div>
    <button type="submit" class="btn btn-primary w-100">Login</button>
}
